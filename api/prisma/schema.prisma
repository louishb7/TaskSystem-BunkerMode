generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model auditoria_eventos {
  evento_id  Int       @id @default(autoincrement())
  missao_id  Int?
  usuario_id Int?
  acao       String    @db.VarChar(80)
  detalhes   String
  criado_em  DateTime  @default(now()) @db.Timestamp(6)
  missoes    missoes?  @relation(fields: [missao_id], references: [missao_id], onDelete: SetNull, onUpdate: Cascade)
  usuarios   usuarios? @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([missao_id])
  @@index([usuario_id])
}

model missoes {
  missao_id           Int                 @id @default(autoincrement())
  titulo              String              @db.VarChar(200)
  prioridade          Int                 @default(2)
  prazo               DateTime?           @db.Date
  instrucao           String?             @db.VarChar(280)
  status              String              @default("PENDENTE") @db.VarChar(20)
  is_pinned           Boolean             @default(false)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @updatedAt @db.Timestamp(6)
  completed_at        DateTime?           @db.Timestamp(6)
  failed_at           DateTime?           @db.Timestamp(6)
  recurrence_weekdays Int[]               @default([])
  recurrence_end_date DateTime?           @db.Date
  duration_type       String?             @db.VarChar(20)
  recurrence_key      String?             @unique @db.VarChar(320)
  criada_por_id       Int
  responsavel_id      Int
  objetivo_id         Int?
  sonho_id            Int?
  auditoria_eventos   auditoria_eventos[]
  criada_por          usuarios            @relation("missoes_criada_por", fields: [criada_por_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)
  responsavel         usuarios            @relation("missoes_responsavel", fields: [responsavel_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)
  objetivos           objetivos?          @relation(fields: [objetivo_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sonhos              sonhos?             @relation(fields: [sonho_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([responsavel_id, status, prazo])
  @@index([objetivo_id])
  @@index([sonho_id])
}

model objetivos {
  id           Int       @id @default(autoincrement())
  usuario_id   Int
  sonho_id     Int?
  titulo       String    @db.VarChar(200)
  descricao    String?
  data_alvo    DateTime? @db.Date
  progresso    Int       @default(0)
  status       String    @default("ativo") @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @updatedAt @db.Timestamp(6)
  concluded_at DateTime? @db.Timestamp(6)
  order_index  Int       @default(0)
  missoes      missoes[]
  sonhos       sonhos?   @relation(fields: [sonho_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  usuarios     usuarios  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuario_id, status])
  @@index([sonho_id])
}

model revisoes_semanais {
  revisao_id             Int      @id @default(autoincrement())
  usuario_id             Int
  start_date             DateTime @db.Date
  end_date               DateTime @db.Date
  reviewed_at            DateTime @default(now()) @db.Timestamp(6)
  resumo_operacional     String
  completed_missions     Int      @default(0)
  pending_missions       Int      @default(0)
  failed_missions        Int      @default(0)
  high_priority_missions Int      @default(0)
  observacao             String?
  usuarios               usuarios @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([usuario_id, start_date, end_date])
}

model sonhos {
  id                         Int         @id @default(autoincrement())
  usuario_id                 Int
  titulo                     String      @db.VarChar(200)
  descricao                  String?
  tipo                       String      @db.VarChar(20)
  status                     String      @default("ativo") @db.VarChar(20)
  justificativa_arquivamento String?
  created_at                 DateTime    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime    @updatedAt @db.Timestamp(6)
  archived_at                DateTime?   @db.Timestamp(6)
  concluded_at               DateTime?   @db.Timestamp(6)
  missoes                    missoes[]
  objetivos                  objetivos[]
  usuarios                   usuarios    @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuario_id, status])
}

model usuarios {
  usuario_id        Int                 @id @default(autoincrement())
  usuario           String              @unique @db.VarChar(80)
  email             String              @unique @db.VarChar(254)
  senha_hash        String
  ativo             Boolean             @default(true)
  nome_general      String?
  active_mode       String              @default("general") @db.VarChar(20)
  timezone          String              @default("America/Recife") @db.VarChar(80)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @updatedAt @db.Timestamp(6)
  auditoria_eventos auditoria_eventos[]
  missoes_criadas   missoes[]           @relation("missoes_criada_por")
  missoes_recebidas missoes[]           @relation("missoes_responsavel")
  objetivos         objetivos[]
  revisoes_semanais revisoes_semanais[]
  sonhos            sonhos[]
}
